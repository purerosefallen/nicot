{
  "name": "nicot",
  "description": "Nest.js interacting with class-validator + OpenAPI + TypeORM for Nest.js Restful API development.",
  "version": "2.0.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "lint": "eslint --fix .",
    "build": "node build.js",
    "build:cjs": "node build.js cjs",
    "build:esm": "node build.js esm",
    "build:types": "node build.js types",
    "clean": "node build.js clean",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purerosefallen/nicot.git"
  },
  "author": "Nanahira <nanahira@momobako.com>",
  "license": "MIT",
  "keywords": [
    "typescript",
    "typeorm",
    "nest",
    "nestjs",
    "rest",
    "restful",
    "api",
    "crud",
    "crud-generator",
    "backend",
    "frameworks"
  ],
  "bugs": {
    "url": "https://github.com/purerosefallen/nicot/issues"
  },
  "homepage": "https://github.com/purerosefallen/nicot",
  "devDependencies": {
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.0.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "class-validator": "^0.15.1",
    "esbuild": "^0.28.0",
    "esbuild-register": "^3.6.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^3.4.1",
    "pg": "^8.7.3",
    "prettier": "^2.7.1",
    "rxjs": "^7.8.2",
    "supertest": "^6.2.4",
    "typeorm": "^1.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0 || ^0.15.0",
    "rxjs": ">=7.0.0",
    "typeorm": "^0.3.27 || ^1.0.0"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "nesties": "^2.0.0",
    "nfkit": "^1.0.13",
    "p-queue": "^9.3.3",
    "reflect-metadata": "^0.2.2",
    "superjson": "1.13.3",
    "typed-reflector": "^1.1.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
