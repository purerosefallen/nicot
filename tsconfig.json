{
	"compilerOptions": {
		"outDir": "dist",
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"nicot": ["./index.ts"]
		},
		"target": "es2023",
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"declaration": true,
		"sourceMap": true,
		"strict": false,
		"skipLibCheck": true,
		"types": [
			"node",
			"vitest/globals"
		]
	},
	"compileOnSave": true,
	"allowJs": true,
	"include": [
		"*.ts",
		"src/**/*.ts",
		"test/**/*.ts",
		"tests/**/*.ts"
	]
}
